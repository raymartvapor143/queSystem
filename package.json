{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "que-system-desktop",
  "version": "1.0.0",
  "description": "Queuing System Ticket Generator & Dashboard Desktop Application",
  "author": "QueSystem",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "electron:dev": "electron desktop/main.cjs",
    "electron:build": "vite build && electron-builder --win dir"
  },
  "build": {
    "appId": "com.quesystem.app",
    "productName": "QueSystem",
    "asar": false,
    "files": [
      "desktop/**/*",
      "public/**/*",
      "app/**/*",
      "bootstrap/**/*",
      "config/**/*",
      "database/**/*",
      "resources/views/**/*",
      "routes/**/*",
      "storage/**/*",
      "vendor/**/*",
      "artisan",
      ".env.example",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "dir"
      ]
    },
    "directories": {
      "output": "dist-desktop"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axios": "^1.11.0",
    "concurrently": "^9.0.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "laravel-vite-plugin": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.7"
  },
  "dependencies": {
    "framer-motion": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.14"
  }
}